#!/usr/bin/env php
<?php

use Webman\Config;
use WebmanTech\CommonUtils\Container;
use WebmanTech\LaravelConsole\Kernel;

// 与 $root/pest 同理：BASE_PATH 指向本夹具应用，需在 autoload 前定义
if (!defined('BASE_PATH')) {
    define('BASE_PATH', __DIR__);
}

require __DIR__ . '/../../vendor/autoload.php';

// same as webman/console
if (!in_array($argv[1] ?? '', ['start', 'restart', 'stop', 'status', 'reload', 'connections'])) {
    //require_once __DIR__ . '/support/bootstrap.php';
    require_once __DIR__ . '/../bootstrap.php'; // 测试环境下使用
} else {
    if (class_exists('Support\App')) {
        Support\App::loadAllConfig(['route']);
    } else {
        Config::reload(config_path(), ['route', 'container']);
    }
}

$kernel = Container::getCurrent()->get(Kernel::class);
$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

exit($status);
